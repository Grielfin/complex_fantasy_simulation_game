User --|> Storyteller
Storyteller --|> Event
Event --|> Weather
Weather --|> EnumsRelated
Storyteller --|> Entity
Entity --|> Furniture
Entity --|> Tile
Storyteller --|> WorldGenerator
WorldGenerator --|> EnumsRelated
OnTile --|> Storage
Tile --|> Storage
Storage --|> Item
Item --|> EnumsRelated
EnumsRelated--|> Factory
Factory --|> Basic
Basic --|> Enums
@enduml