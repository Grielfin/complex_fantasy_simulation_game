@startuml
allowmixing
skinparam linetype ortho
left to right direction

package WORLD_ASSETS {

class GroundTile {
-coo : Vec
-ground_storage : Storage*
-onTile : OnTile*
-ground_type : GroundTypes
-durability : float
+heat_manager : HeatManager
..Getter Const..
+""float"" getHardness()
+""float"" getMaxDurability()
+""vector<MaterialPercentage>"" getMaterialComposition()
+""float"" getWalkingSpeed()
+""float"" getResistanceEnvironment(EnvironmentDamageType damage_type)
..Getter..
+""float"" getDurability()
}

abstract OnTile {
-coo : Vec
-name : OnTileName
-ground_tile_owner : GroundTile*
-durability : float
-max_durability : float
-hardness : float
-can_be_walked_on : bool
-material_composition : vector<MaterialPercentage>
-resistance_environment : map<EnvironmentDamagesType,float>
+heat_manager : HeatManager
..Getter..
+""Vec"" getCoo()
+""OnTileName"" getName()
+""vector<GroundTile*>"" getGroundTileOwners()
}

class Furniture {
-size_x : int
-size_y : int
-isStation : bool
-author : string
-working_positions : vector<Vec>
}

class Plant {
}

class Block {
-natural_floor : FloorType
}

class Liquid {
}

Furniture --> OnTile
Plant --> OnTile
Block --> OnTile
Liquid --> OnTile
}

@enduml