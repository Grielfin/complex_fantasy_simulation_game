@startuml
allowmixing
skinparam linetype ortho
left to right direction

package WORLD_ASSETS {

class GroundTile {
-coo : Vec
-ground_storage : Storage*
-onTile : OnTile*
-floor_type : FloorTypes
-durability : int
-max_durability : int
+heat_manager : HeatManager
..Getter..
+""float"" getHardness()
+""vector<MaterialPercentage>"" getMaterialComposition()
+""float"" getWalkingSpeed()
+""float"" getResistanceEnvironment(EnvironmentDamageType damage_type)
}

abstract OnTile {
-coo : Vec
-name : OnTileName
-ground_tile_owners : vector<GroundTile*>
-size_x : int
-size_y : int
-durability : float
-max_durability : float
-hardness : float
-can_be_walked_on : bool
-material_composition : vector<MaterialPercentage>
+heat_manager : HeatManager
-resistance_environment : map<EnvironmentDamagesType,float>
..Getter..
+""Vec"" getCoo()
+""OnTileName"" getName()
+""vector<GroundTile*>"" getGroundTileOwners()
}

class Furniture {
-isStation : bool
-author : string
-working_positions : vector<Vec>
}

class Plant {
}

class Block {
-natural_floor : FloorType
}

Furniture --> OnTile
Plant --> OnTile
Block --> OnTile
}

@enduml