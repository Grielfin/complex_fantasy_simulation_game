@startuml
allowmixing
skinparam linetype ortho
left to right direction

package WORLD_ASSETS {

class GroundTile {
-coo : Vec3D
-ground_storage : Storage*
-onTile : OnTile*
-floor_type : FloorsType
-ground_type : GroundsType
-durability : float
+heat_manager : HeatManager
..Getter Const..
+""float"" getHardness()
+""float"" getMaxDurability()
+""vector<MaterialPercentage>"" getMaterialComposition()
+""float"" getWalkingSpeed()
+""float"" getResistanceEnvironment(EnvironmentDamageType damage_type)
..Getter..
+""float"" getDurability()
}

abstract OnTile {
-coo : Vec3D
-name : OnTileName
-ground_tile_owner : GroundTile*
-durability : float
-max_durability : float
-hardness : float
-can_be_walked_on : bool
-can_be_roofed : bool
-material_composition : vector<MaterialPercentage>
-resistance_environment : map<EnvironmentDamagesType,float>
+heat_manager : HeatManager
..Getter Const..
+""Vec"" getCoo()
+""OnTileName"" getName()
+""vector<GroundTile*>"" getGroundTileOwners()
+""float"" getMaxDurability()
..Getter..
+""float"" getDurability()
+""float"" canGetRoofed()
}

class Furniture {
-size : Vec2D
-isStation : bool
-author : string
-working_positions : vector<Vec2D>
}

class Plant {
}

class Block {
-ground_type : GroundTypes
}

class Liquid {
}

Furniture --> OnTile
Plant --> OnTile
Block --> OnTile
Liquid --> OnTile
}

@enduml