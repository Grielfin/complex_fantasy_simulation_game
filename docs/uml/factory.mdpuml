@startuml
allowmixing
skinparam linetype ortho
left to right direction

rectangle Recipe
rectangle Item
rectangle HeatParameters
rectangle Entity

package FACTORY {

package Data {
entity ItemData {
item_name_to_clone : map<ItemsName,Item*>
item_name_to_recipe : map<ItemsName,Recipe*>
}

entity HeatData {
material_to_heat_parameters : map<Material,HeatParameters>
}

entity BeautyData {
item_name_to_beauty : map<ItemsName,BeautyStats>
ground_type_to_beauty : map<GroundsType,BeautyStats>
floor_type_to_beauty : map<GroundsType,BeautyStats>
ontile_name_to_beauty : map<OnTilesName,BeautyStats>
}

entity TileData {
groud_type_to_ground_stats : map<GroundsType,GroundFloorStats>
floor_type_to_floor_stats : map<FloorsType,GroundFloorStats>
}

ItemData ..> Recipe
ItemData..> Item
HeatData ..> HeatParameters
}

package Save {
entity EntitySave {
all_entities : vector<Entity*>
}

EntitySave ..> Entity
}

}

@enduml